# เลือก provider และโมเดล (เปลี่ยนที่นี่ที่เดียว)
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=

# provider อื่น: LLM_PROVIDER=opencode (ใช้ OPENCODE_GO_KEY, โมเดลเริ่มต้น deepseek-v4.1-flash)
# OPENCODE_GO_KEY=

# provider อีกเจ้า: LLM_PROVIDER=deepseek (ใช้ DEEPSEEK_API_KEY, โมเดลเริ่มต้น deepseek-flash)
# DEEPSEEK_API_KEY=

# provider อีกเจ้า: LLM_PROVIDER=google (ใช้ GOOGLE_API_KEY ตัวเดียวกับ embedding ด้านล่าง, โมเดลเริ่มต้น gemini-flash-lite-latest)

# ใช้กับบทที่ต้องมีฐานข้อมูลจริง (เช่น 4-24) เปิดฐานข้อมูลด้วย: docker compose up -d
DATABASE_URL=postgresql://langgraph:langgraph@localhost:5434/langgraph_course

# embedding สำหรับบทค้นหาด้วยความหมาย (Level 5): ขอ key ฟรีที่ Google AI Studio
GOOGLE_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768   # ต้องตรงกับ vector(N) ในตาราง
