{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@src/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "lessons/**/solution/**/*.ts"
  ],
  "exclude": [
    "scripts/lesson-template",
    "legacy",
    ".tmp-check",
    "scripts/fixtures/.tmp-check"
  ]
}
