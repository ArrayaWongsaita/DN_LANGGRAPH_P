{
  "name": "langgraph-course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run src scripts",
    "test:lesson": "tsx scripts/test-lesson.ts",
    "lesson": "tsx scripts/run-lesson.ts",
    "check:solutions": "tsx scripts/check-lessons-cli.ts --mode solutions",
    "check:starters": "tsx scripts/check-lessons-cli.ts --mode starters",
    "check:llm": "tsx scripts/check-llm.ts",
    "lint:lessons": "tsx scripts/lint-lessons-cli.ts",
    "lint:lessons:strict": "tsx scripts/lint-lessons-cli.ts --strict",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@langchain/core": "1.4.1",
    "@langchain/google-genai": "2.3.6",
    "@langchain/groq": "1.3.1",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint": "1.2.3",
    "@langchain/langgraph-checkpoint-postgres": "1.1.3",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "@langchain/mcp-adapters": "2.0.3",
    "@langchain/ollama": "1.3.0",
    "@langchain/openai": "1.8.4",
    "@langchain/textsplitters": "1.0.2",
    "express": "^5.3.0",
    "langchain": "1.6.6",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.8.0",
    "@langchain/langgraph-sdk": "^1.17.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
